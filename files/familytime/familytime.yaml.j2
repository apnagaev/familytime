# {{ ansible_managed }}
services:
  familytime:
    build: ./server
    image: familytime:{{ familytime_version }}
    container_name: familytime
    restart: unless-stopped
    env_file: familytime.env
    ports:
      - "{{ familytime_port }}:8000"
    networks:
      - familytime
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  familytime:
    name: familytime
    ipam:
      config:
        - subnet: {{ familytime_subnet }}
