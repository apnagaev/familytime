# Сайт портала и API агентов. Положите в sites/ OpenResty на обоих балансировщиках,
# подставьте имя, адреса узлов и подключение сертификата, как у остальных сайтов.
upstream familytime_backend {
    server 10.0.0.1:8097 max_fails=2 fail_timeout=10s;
    server 10.0.0.2:8097 max_fails=2 fail_timeout=10s;
    keepalive 16;
}

server {
    listen 80;
    server_name kids.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name kids.example.com;

    ssl_certificate     /etc/nginx/ssl/example.com.cer;
    ssl_certificate_key /etc/nginx/ssl/example.com.key;

    client_max_body_size 2m;

    location / {
        proxy_pass http://familytime_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503;
        proxy_read_timeout 60s;
    }

    # агенты стучатся раз в минуту — их запросы не пишем в журнал
    location /api/agent/ {
        access_log off;
        proxy_pass http://familytime_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_next_upstream error timeout http_502 http_503;
    }
}
